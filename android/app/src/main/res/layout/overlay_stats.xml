<?xml version="1.0" encoding="utf-8"?>
<!-- Background, padding, sizes and visibility are applied in code
     (OverlayService.applyConfig) from the user's customization. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/fps_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- FPS"
        android:textColor="#4ADE80"
        android:textSize="21sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <TextView
        android:id="@+id/temp_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="CPU --°  GPU --°"
        android:textColor="#E5E7EB"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/usage_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="CPU --%  GPU --%"
        android:textColor="#C7CCD6"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/ram_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="RAM -- MB free"
        android:textColor="#9CA3AF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/power_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="-- mA  -- W"
        android:textColor="#FBBF24"
        android:textSize="11sp" />
</LinearLayout>
